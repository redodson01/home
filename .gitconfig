[commit]
	gpgSign = true
[core]
	excludesFile = ~/.gitignore
	pager = delta
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[fetch]
	prune = true
	pruneTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[rebase]
	autoSquash = true
[tag]
	gpgSign = true
[user]
	email = richardedodson01@icloud.com
	name = Richard E. Dodson
[includeIf "hasconfig:remote.*.url:git@github.com:givecampus/**"]
	path = ~/.gitconfig-givecampus
