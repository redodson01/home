{
  "permissions": {
    "deny": [
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd-guard"
          }
        ]
      }
    ]
  }
}
