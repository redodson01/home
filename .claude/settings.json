{
  "permissions": {
    "deny": [
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "outputStyle": "neutral",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "auto"
}
