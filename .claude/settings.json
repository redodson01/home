{
  "permissions": {
    "deny": [
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state !"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state …"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state …"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd-guard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -u -w -t \"${TMUX_PANE}\" @window_state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state ✓"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state !"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -z \"${TMUX_PANE}\" ]] || tmux set-option -w -t \"${TMUX_PANE}\" @window_state …"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "outputStyle": "neutral",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "auto"
}
