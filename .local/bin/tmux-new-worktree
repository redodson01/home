#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

if [[ -n "${DEBUG:-}" ]]; then
  set -o xtrace
fi

function print-usage {
  cat <<\EOF
Usage:
  tmux-new-worktree [-b <branch>] [--] <worktree> [<commit-ish>]
  tmux-new-worktree -h
EOF
}

while getopts 'b:h' opt; do
  case "${opt}" in
  b)
    branch="${OPTARG}"
    ;;
  h)
    print-usage
    exit
    ;;
  *)
    print-usage >&2
    exit 2
    ;;
  esac
done

shift $((OPTIND - 1))

if [[ $# -lt 1 ]]; then
  echo 'Error: <worktree> required'
  print-usage >&2
  exit 2
fi

worktree="${1}"

if [[ $# -gt 1 ]]; then
  commit="${2}"
fi

set --

if [[ -n "${branch:-}" ]]; then
  set -- "${@}" -b "${branch}"
fi

set -- "${@}" ".claude/worktrees/${worktree}"

if [[ -n "${commit:-}" ]]; then
  set -- "${@}" "${commit}"
fi

git worktree add "${@}"

tmux new-window -d -c ".claude/worktrees/${worktree}" -n "${worktree}"
tmux split-window -d -h -t "${worktree}" claude --name="${worktree}" --worktree="${worktree}"
tmux split-window -d -c ".claude/worktrees/${worktree}" -t "${worktree}" git watch bss
tmux select-window -t "${worktree}"
