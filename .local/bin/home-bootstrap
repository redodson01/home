#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

if [[ -n "${DEBUG:-}" ]]; then
  set -o xtrace
fi

export NVM_DIR="${HOME}/.nvm"
export PATH="${HOME}/.local/bin:${PATH}"

if [[ ! -d "${HOME}/.ssh" ]]; then
  local_host_name="$(scutil --get LocalHostName)"
  git clone --branch="${local_host_name}" https://github.com/redodson01/.ssh.git "${HOME}/.ssh"
  git -C "${HOME}/.ssh" remote set-url origin git@github.com:redodson01/.ssh.git
  chmod 400 "${HOME}/.ssh/id_ed25519"
fi

if [[ ! -d "${HOME}/.gnupg" ]]; then
  git clone git@github.com:redodson01/.gnupg.git "${HOME}/.gnupg"
  chmod 700 "${HOME}/.gnupg"
fi

if [[ ! -d "${HOME}/.password-store" ]]; then
  git clone git@github.com:redodson01/.password-store.git "${HOME}/.password-store"
fi

if [[ ! -d "${HOME}/.local/share/home" ]]; then
  git init --bare --initial-branch=main "${HOME}/.local/share/home"
  git --git-dir="${HOME}/.local/share/home" config status.showUntrackedFiles no
  git --git-dir="${HOME}/.local/share/home" remote add -f origin git@github.com:redodson01/home.git
  git --git-dir="${HOME}/.local/share/home" --work-tree="${HOME}" checkout --force main
fi

if command -v /opt/homebrew/bin/brew >/dev/null; then
  brew_shellenv="$(/opt/homebrew/bin/brew shellenv bash)"
  eval "${brew_shellenv}"
fi

if command -v brew >/dev/null; then
  brew update
else
  homebrew_install="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  /bin/bash -c "${homebrew_install}"
  brew_shellenv="$(/opt/homebrew/bin/brew shellenv bash)"
  eval "${brew_shellenv}"
fi

brew bundle --global install

if [[ -n "${CLEAN:-}" ]]; then
  brew bundle --global cleanup --force
fi

brew cleanup --prune=all

user_shell="$(dscl . -read "${HOME}" UserShell)"

if [[ "${user_shell}" != "UserShell: ${HOMEBREW_PREFIX:?}/bin/bash" ]]; then
  sudo chsh -s "${HOMEBREW_PREFIX:?}/bin/bash" "${USER}"
fi

if [[ -f "${HOME}/.vim/autoload/plug.vim" ]]; then
  vim -c PlugUpgrade -c quitall
else
  curl -fLo ~/.vim/autoload/plug.vim --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

vim -c PlugUpdate -c quitall

if [[ -n "${CLEAN:-}" ]]; then
  vim -c 'PlugClean!' -c quitall
fi

curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.8/install.sh | bash

# shellcheck disable=SC2250
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  source "$NVM_DIR/nvm.sh"
fi

# shellcheck disable=SC2250
if [[ -s "$NVM_DIR/bash_completion" ]]; then
  # shellcheck source=/dev/null
  source "$NVM_DIR/bash_completion"
fi

if command -v nvm >/dev/null; then
  nvm install --lts --latest-npm
  nvm alias default 'lts/*'
fi

if [[ -f "${HOME}/.cargo/env" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.cargo/env"
fi

if command -v rustup >/dev/null; then
  rustup update
else
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- --yes --no-modify-path
  # shellcheck source=/dev/null
  source "${HOME}/.cargo/env"
fi

if command -v claude >/dev/null; then
  claude update
else
  curl -fsSL https://claude.ai/install.sh | bash
fi

if command -v npm >/dev/null; then
  npm install --global ccstatusline@latest
fi

if command -v gh >/dev/null; then
  if ! gh auth status >/dev/null; then
    gh auth login
  fi
fi

if command -v claude >/dev/null; then
  if ! claude auth status >/dev/null; then
    claude auth login
  fi
fi

if command -v heroku >/dev/null; then
  if ! heroku whoami &>/dev/null; then
    heroku login
  fi
fi
